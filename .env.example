# Server-only: the Express API origin. The browser never calls it directly —
# next.config.ts rewrites /api/v1/* to it, so auth cookies stay first-party.
API_ORIGIN=http://localhost:5000
# Same value as the API's REVALIDATE_SECRET; lets the API refresh cached doctor pages.
REVALIDATE_SECRET=replace-with-a-random-string
# Optional: enables "Sign in with Google" for patients. Must match the API's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
